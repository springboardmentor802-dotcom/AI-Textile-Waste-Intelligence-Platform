# Copy this file to `.env` and fill in real values.
# Never commit the real `.env` file - it is already covered by .gitignore.

# --- Email notifications (SMTP) ---
# Used by services/email_service.py to send the email counterpart of
# in-app notifications (waste collection, AI prediction, recycling
# opportunity, inventory warning, platform announcement).
#
# If these are left unset, the application still runs normally and
# in-app notifications still work - email is simply skipped, and a
# message is logged server-side.

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=alerts@your-domain.com

# Optional. Defaults to true (STARTTLS on the port above, e.g. 587).
# Set to false only if your SMTP provider requires a plain/implicit
# connection (e.g. port 25 with no TLS).
SMTP_USE_TLS=true
